<% layout("/layouts/boilerplate") %>
    <style>
        /* Listing Details Page - Responsive Design */

        @media (max-width: 768px) {

            .listing-show-page>.col-8.offset-2 {
                width: 90%;
                margin-left: auto;
                margin-right: auto;
            }

            .listing-show-page h3 {
                font-size: 23px;
                margin-bottom: 15px;
            }

            .listing-show-page h4 {
                font-size: 20px;
            }

            /* Listing Image */
            .listing-show-page .show-img {
                width: 100%;
                height: 250px;
                object-fit: cover;
            }

            /* Listing Details */
            .listing-show-page .card-body {
                padding: 15px;
            }

            .listing-show-page .card-text,
            .listing-show-page li {
                font-size: 14px;
                line-height: 1.6;
            }

            /* Edit and Delete Buttons */
            .listing-show-page .showbtns {
                display: flex;
                gap: 12px;
                margin-top: 15px;
            }

            .listing-show-page .showbtns form {
                flex: 1;
            }

            .listing-show-page .showbtns a,
            .listing-show-page .showbtns button {
                width: 100%;
            }

            /* Booking Card */
            .listing-show-page .booking-card {
                width: 100%;
            }

            .listing-show-page .booking-title {
                font-size: 21px;
            }

            .listing-show-page .booking-subtitle {
                font-size: 14px;
            }

            .listing-show-page .booking-btn {
                width: 100%;
            }

            /* Reviews */
            .listing-show-page .starability-slot {
                max-width: 100%;
            }

            .listing-show-page .form-control {
                font-size: 15px;
            }

            .listing-show-page .row .col-5 {
                width: 100%;
                margin-left: 0 !important;
            }

            /* Map */
            #map {
                height: 350px !important;
                width: 100%;
            }
        }

        @media (max-width: 480px) {

            .listing-show-page>.col-8.offset-2 {
                width: 94%;
                padding: 0 5px;
            }

            .listing-show-page h3 {
                font-size: 21px;
            }

            .listing-show-page h4 {
                font-size: 19px;
            }

            .listing-show-page .show-img {
                height: 210px;
            }

            .listing-show-page .card-body {
                padding: 12px;
            }

            .listing-show-page li {
                font-size: 13px;
                margin-bottom: 5px;
            }

            .listing-show-page .showbtns {
                flex-direction: column;
            }

            .listing-show-page .booking-card {
                margin-top: 20px !important;
            }

            .listing-show-page .booking-title {
                font-size: 19px;
            }

            .listing-show-page .booking-notice {
                font-size: 12px;
                text-align: center;
            }

            .listing-show-page textarea {
                min-height: 100px;
            }

            #map {
                height: 280px !important;
            }
        }

        @media (max-width: 768px) {
            .listing-map-section {
                width: 90%;
                margin-left: auto;
                margin-right: auto;
            }

            .listing-map-section h3 {
                font-size: 23px;
            }
        }

        @media (max-width: 480px) {
            .listing-map-section {
                width: 94%;
                padding: 0 5px;
            }

            .listing-map-section h3 {
                font-size: 21px;
            }
        }
        /* Booking Card Responsive Design */

/* .booking-card {
    width: 100%;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
} */

@media (max-width: 768px) {
    .booking-card {
        max-width: 100%;
        margin-top: 20px !important;
    }

    .booking-card .card-body {
        padding: 20px;
    }

    .booking-title {
        font-size: 21px;
    }

    .booking-subtitle {
        font-size: 14px;
    }

    .booking-card .form-control {
        font-size: 15px;
        padding: 10px;
    }

    .booking-btn {
        width: 100%;
        padding: 11px;
    }

    .booking-notice {
        font-size: 13px;
        text-align: center;
    }
}

@media (max-width: 480px) {
    .booking-card .card-body {
        padding: 15px;
    }

    .booking-title {
        font-size: 19px;
    }

    .booking-subtitle {
        font-size: 13px;
    }

    .booking-card .form-label {
        font-size: 14px;
    }

    .booking-card .form-control {
        font-size: 14px;
        padding: 9px;
    }

    .booking-btn {
        font-size: 14px;
        padding: 10px;
    }

    .booking-notice {
        font-size: 12px;
    }
}
    </style>
    <script>
        const maptoken = "<%= mapToken %>";
        const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %> ;
    </script>

    <body>
        <div class="row listing-show-page">
            <div class="col-8 offset-2">
                <h3>Listing details:</h3>
                <div class="card listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
                    <div class="card-body">
                        <p class="card-text">
                        <p>Owned by <%= listing.owner.username %>
                        </p>
                        <ul>
                            <li>
                                <%= listing.title %>
                            </li>
                            <li>
                                <%= listing.description %>
                            </li>
                            <li> &#8377; <%= listing.price %>
                            </li>
                            <li>
                                <%= listing.location %>
                            </li>
                            <li>
                                <%= listing.country %>
                            </li>
                        </ul>
                        </p>
                    </div>
                </div>
                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                    <div class="showbtns">
                        <a href="/listings/<%= listing._id%>/edit" class="btn btn-dark"
                            style="background-color: red;">Edit</a>
                        <br>
                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                            <button class="btn btn-dark">Delete</button>
                        </form>
                    </div>
                    <% } %>


                        <div class="card booking-card mt-4 mb-3">
                            <div class="card-body">

                                <h4 class="booking-title">
                                    <i class="fa-regular fa-calendar-check me-2"></i>
                                    Book this property
                                </h4>

                                <p class="booking-subtitle">
                                    Plan your next getaway with Roamnest.
                                </p>

                                <form action="/listings/<%= listing._id %>/book" method="POST" novalidate
                                    class="needs-validation">

                                    <div class="mb-3">
                                        <label for="checkIn" class="form-label">
                                            <i class="fa-solid fa-calendar-day me-1"></i>
                                            Check-in
                                        </label>
                                        <input type="date" id="checkIn" name="checkIn" class="form-control"
                                            min="<%= new Date().toISOString().split('T')[0] %>" required>
                                        <div class="invalid-feedback">Date should be valid</div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="checkOut" class="form-label">
                                            <i class="fa-solid fa-calendar-check me-1"></i>
                                            Check-out
                                        </label>
                                        <input type="date" id="checkOut" name="checkOut" class="form-control"
                                            min="<%= new Date().toISOString().split('T')[0] %>" required>
                                        <div class="invalid-feedback">Date should be valid</div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="guests" class="form-label">
                                            <i class="fa-solid fa-users me-1"></i>
                                            Number of guests
                                        </label>
                                        <input type="number" id="guests" name="guests" class="form-control" min="1"
                                            max="20" value="1" required>
                                    </div>

                                    <button type="submit" class="btn booking-btn">
                                        Request Booking
                                        <i class="fa-solid fa-arrow-right ms-2"></i>
                                    </button>

                                </form>

                                <p class="booking-notice">
                                    <i class="fa-solid fa-shield-halved"></i>
                                    Your stay requires owner approval.
                                </p>

                            </div>
                        </div>


                        <% if(currUser) { %>
                            <h4>Leave a review</h4>
                            <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate
                                class="needs-validation">
                                <div class="mt-3 mb-3">
                                    <label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                            value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>

                                </div>
                                <div class="mt-3 mb-3">
                                    <label for="comment" class="form-label">Comment</label>
                                    <textarea name="review[comment]" id="comment" class="form-control"
                                        required></textarea>
                                    <div class="invalid-feedback">Please add some comment for the review</div>
                                </div>
                                <div class="mt-3 mb-3">
                                    <button class="btn btn-outline-dark">Submit</button>
                                </div>
                            </form>
                            <%}%>
                                <% if (listing.reviews.length> 0) { %>
                                    <div class="row">
                                        <h4>All reviews</h4>
                                        <% for(let review of listing.reviews) { %>
                                            <div class="card mb-3 ms-4 col-5 review-card">
                                                <div class="card-body">
                                                    <h5 class="card-title">
                                                        <%= review.author.username %>
                                                    </h5>
                                                    <p class="card-text">
                                                        <%= review.comment %>
                                                    </p>
                                                    <p class="starability-result" data-rating="<%= review.rating %>">
                                                    </p>
                                                    <form
                                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                        method="post" class="mb-3">
                                                        <button class="btn btn-dark">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% } %>
                                    </div>
                                    <% } %>
            </div>

        </div>
        <div class="col-8 offset-2 mb-3 listing-map-section">
            <h3>Where you'll be</h3>
            <div id="map" style="height: 400px;"></div>
        </div>
        <script src="/js/map.js"></script>

    </body>