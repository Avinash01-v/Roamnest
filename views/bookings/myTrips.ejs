<% layout("/layouts/boilerplate") %>
    <style>
        /* My Trips - Smartphone Responsiveness */

        @media (max-width: 768px) {

            .container.mt-5.mb-5 {
                margin-top: 25px !important;
                margin-bottom: 25px !important;
                padding-left: 16px;
                padding-right: 16px;
            }

            .container h2 {
                font-size: 24px;
                margin-bottom: 20px !important;
            }

            /* Trip cards */
            .container .card {
                margin-bottom: 10px;
            }

            .container .card-img-top {
                height: 200px !important;
                width: 100%;
                object-fit: cover;
            }

            .container .card-body {
                padding: 14px 8px;
            }

            .container .card-title {
                font-size: 18px;
            }

            .container .card-body p {
                font-size: 14px;
            }
        }

        @media (max-width: 480px) {

            .container.mt-5.mb-5 {
                margin-top: 18px !important;
                padding-left: 12px;
                padding-right: 12px;
            }

            .container h2 {
                font-size: 21px;
            }

            .container .card-img-top {
                height: 190px !important;
            }

            .container .card-body {
                padding: 12px 6px;
            }

            .container .card-title {
                font-size: 17px;
            }

            .container .card-body p {
                font-size: 13px;
            }

            .container .card-body .btn {
                width: 100%;
                padding: 8px;
            }
        }
    </style>
    <div class="container mt-5 mb-5">
        <h2 class="mb-4">My Trips</h2>

        <% if (bookings.length===0) { %>
            <div class="alert alert-info">
                You haven't booked any trips yet.
                <a href="/listings" class="alert-link">Explore stays</a>
            </div>
            <% } else { %>

                <div class="row">
                    <% bookings.forEach(booking=> { %>
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100" style="border: none; box-shadow: none; padding: 0.5rem;">

                                <% if (booking.listing) { %>
                                    <a href="/listings/<%= booking.listing._id %>">
                                        <img src="<%= booking.listing.image.url %>" class="card-img-top"
                                            alt="<%= booking.listing.title %>"
                                            style="height: 220px; object-fit: cover; border-radius: 12px;">
                                    </a>
                                    <% } %>

                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <%= booking.listing ? booking.listing.title : "Listing unavailable" %>
                                            </h5>

                                            <p class="mb-2">
                                                <strong>Check-in:</strong>
                                                <%= new Date(booking.checkIn).toLocaleDateString("en-IN") %>
                                            </p>

                                            <p class="mb-2">
                                                <strong>Check-out:</strong>
                                                <%= new Date(booking.checkOut).toLocaleDateString("en-IN") %>
                                            </p>

                                            <p class="mb-3">
                                                <strong>Guests:</strong>
                                                <%= booking.guests %>
                                            </p>

                                            <p class="mb-0">
                                                <strong>Status:</strong>
                                                <span class="badge
                                    <%= booking.status === 'confirmed' ? 'bg-success' :
                                        booking.status === 'rejected' ? 'bg-danger' :
                                        booking.status === 'cancelled' ? 'bg-secondary' :
                                        'bg-warning text-dark' %>">
                                                    <%= booking.status %>
                                                </span>
                                            </p>
                                            <% if (booking.status==="pending" || booking.status==="confirmed" ) { %>
                                                <form action="/bookings/<%= booking._id %>/cancel" method="POST"
                                                    onsubmit="return confirm('Are you sure you want to cancel this booking?');"
                                                    class="mt-3">

                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        Cancel Booking
                                                    </button>

                                                </form>
                                                <% } %>
                                        </div>

                            </div>
                        </div>
                        <% }) %>
                </div>

                <% } %>
    </div>